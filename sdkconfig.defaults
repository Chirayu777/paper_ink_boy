# Default SDK configuration for Paper Ink Boy on the Atlas board (ESP32-C5 N16R8).
# Applied on a fresh build (delete sdkconfig, or idf.py fullclean, after changing this file).

CONFIG_IDF_TARGET="esp32c5"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Partitions: app + saves + an 8 MB ROM slot
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-C5 N16R8: 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM -- 8 MB quad PSRAM; holds the display framebuffers and the cartridge RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# CPU / RTOS / compiler -- the emulator wants every cycle
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Console: UART0 115200, USB-Serial-JTAG as secondary
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
